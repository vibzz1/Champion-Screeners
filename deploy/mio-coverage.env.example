# Copy to /etc/mio-coverage.env on the box (root:root, chmod 600) and fill in.
# These values are read by the mio-coverage.service systemd unit.

# From @BotFather when you create the bot (looks like 123456789:AAE...long...).
TELEGRAM_BOT_TOKEN=

# Your numeric chat id. Get it by messaging your new bot once, then:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[0-9-]*'
# or message @userinfobot on Telegram.
TELEGRAM_CHAT_ID=

# --- optional overrides (fine to leave commented) ---
# COVERAGE_URL=http://127.0.0.1:8000/api/intraday/coverage?refresh=1
# COVERAGE_MIN=98
# COVERAGE_ALWAYS=1   # 1 = daily ✅/⚠ ping; 0 = only ping when there's a gap
